{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/scheduler-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/scheduler-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/scheduler-api",
  "projects": {
    "scheduler-api": {
      "type": "application",
      "root": "apps/scheduler-api",
      "entryFile": "main",
      "sourceRoot": "apps/scheduler-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduler-api/tsconfig.app.json"
      }
    },
    "scheduler-worker": {
      "type": "application",
      "root": "apps/scheduler-worker",
      "entryFile": "main",
      "sourceRoot": "apps/scheduler-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduler-worker/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "workshop": {
      "type": "library",
      "root": "libs/workshop",
      "entryFile": "index",
      "sourceRoot": "libs/workshop/src",
      "compilerOptions": {
        "tsConfigPath": "libs/workshop/tsconfig.lib.json"
      }
    },
    "crm": {
      "type": "library",
      "root": "libs/crm",
      "entryFile": "index",
      "sourceRoot": "libs/crm/src",
      "compilerOptions": {
        "tsConfigPath": "libs/crm/tsconfig.lib.json"
      }
    },
    "organization": {
      "type": "library",
      "root": "libs/organization",
      "entryFile": "index",
      "sourceRoot": "libs/organization/src",
      "compilerOptions": {
        "tsConfigPath": "libs/organization/tsconfig.lib.json"
      }
    },
    "sso-mock": {
      "type": "library",
      "root": "libs/sso-mock",
      "entryFile": "index",
      "sourceRoot": "libs/sso-mock/src",
      "compilerOptions": {
        "tsConfigPath": "libs/sso-mock/tsconfig.lib.json"
      }
    }
  }
}
