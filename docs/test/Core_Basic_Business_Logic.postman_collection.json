            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealership_id\": \"{{dealershipId}}\",\n  \"vehicle_id\": \"{{vehicleId}}\",\n  \"service_type_ids\": [\n    \"1\"\n  ],\n  \"start_at\": \"2027-01-15T08:00:00.000Z\",\n  \"customer_notes\": \"Attempting booking beyond 30-day horizon\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "appointments"
              ]
            },
            "description": "Verifies booking requests exceeding horizon_days (> 30 days) are rejected."
          }
        }
      ]
