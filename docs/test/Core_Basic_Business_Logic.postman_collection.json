                  "    var j = pm.response.json();",
                  "    var msg = JSON.stringify(j).toLowerCase();",
                  "    pm.expect(msg).to.satisfy(function(m) { return m.includes('horizon') || m.includes('days') || m.includes('advance'); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
