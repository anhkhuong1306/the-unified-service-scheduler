    {
      "name": "1. Availability Calculation & Policy Enforcement",
      "description": "Tests for 30-min grid alignment, 15-min buffers, lead time (60m) and horizon (30d) enforcement.",
      "item": [
        {
          "name": "[TC_CORE_001] GET /v1/appointments/availability \u2014 30-Min Grid Slot Generation with 15-Min Buffer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response is valid JSON', function () {",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns slots array', function () { var j = pm.response.json(); pm.expect(j.data).to.be.an('array'); });",
                  "pm.test('Slot duration respects service + buffer', function () {",
                  "    var j = pm.response.json();",
                  "    if (j.data && j.data.length > 0) {",
                  "        pm.expect(j.data[0]).to.have.property('start_at');",
                  "        pm.expect(j.data[0]).to.have.property('end_at');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/appointments/availability?dealership_id={{dealershipId}}&date={{targetDate}}&service_type_ids=1&per_page=20&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "appointments",
                "availability"
              ],
              "query": [
                {
                  "key": "dealership_id",
                  "value": "{{dealershipId}}"
                },
                {
                  "key": "date",
                  "value": "{{targetDate}}"
                },
                {
                  "key": "service_type_ids",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Verifies daily availability calculation strictly follows operating hours (08:00 - 18:00), 30-min slot alignment, and adds 15-min cleaning/prep buffer."
          }
        },
        {
          "name": "[TC_CORE_002a] POST /v1/appointments \u2014 Lead Time Rejection (< 60 Minutes)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Set start_at to 20 minutes from now",
                  "var leadDate = new Date(Date.now() + 20 * 60 * 1000);",
                  "pm.collectionVariables.set('leadTimeViolationDate', leadDate.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response is valid JSON', function () {",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test('Status code is 400 or 422 Bad Request/Unprocessable', function () {",
                  "    pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Error message mentions lead time', function () {",
                  "    var j = pm.response.json();",
                  "    var msg = JSON.stringify(j).toLowerCase();",
                  "    pm.expect(msg).to.satisfy(function(m) { return m.includes('lead') || m.includes('advance') || m.includes('violation'); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealership_id\": \"{{dealershipId}}\",\n  \"vehicle_id\": \"{{vehicleId}}\",\n  \"service_type_ids\": [\n    \"1\"\n  ],\n  \"start_at\": \"{{leadTimeViolationDate}}\",\n  \"customer_notes\": \"Attempting urgent booking in 20 minutes\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "appointments"
              ]
            },
            "description": "Verifies that booking requests inside configured lead_time_minutes (< 60 min) are strictly rejected."
          }
        },
        {
          "name": "[TC_CORE_002b] POST /v1/appointments \u2014 Horizon Rejection (> 30 Days)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response is valid JSON', function () {",
