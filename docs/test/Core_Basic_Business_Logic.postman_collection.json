    {
      "name": "2. Booking Engine & Resource Allocation",
      "description": "Happy path booking, Best-Fit technician dispatching, and capacity rejection tests.",
      "item": [
        {
          "name": "[TC_CORE_003] POST /v1/appointments \u2014 Happy Path Atomic Booking (Bay & Tech Allocation)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var uuid = 'idemp-' + Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.variables.set('idempotencyKey1', uuid);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response is valid JSON', function () {",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Appointment has id and code', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.data.id).to.be.a('string');",
                  "    pm.expect(j.data.status).to.be.oneOf(['confirmed', 'pending_approval']);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data.id) {",
                  "    pm.collectionVariables.set('coreAppointmentId', jsonData.data.id);",
                  "    console.log('Set collection variable coreAppointmentId:', jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey1}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealership_id\": \"{{dealershipId}}\",\n  \"vehicle_id\": \"{{vehicleId}}\",\n  \"service_type_ids\": [\n    \"1\"\n  ],\n  \"start_at\": \"2026-11-10T08:00:00.000Z\",\n  \"customer_notes\": \"Standard oil and filter service\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "appointments"
              ]
            },
            "description": "Executes complete booking transaction, allocating Bay and Qualified Tech atomically under pg_advisory_xact_lock. Auto-saves `coreAppointmentId`."
          }
