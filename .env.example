APP_NAME="Unified Service Scheduler"
NODE_ENV=development
TZ=UTC
APP_PORT=3000
APP_URL=http://localhost:3000

# Structured Pino Logging & Observability (§11.1)
LOG_LEVEL=info
LOG_RESPONSE_MAX_BYTES=0
LOG_SPAN_SAMPLING_RATE=1.0

# PostgreSQL 18 Primary Database (§5)
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=secret
PGDATA=/var/lib/postgresql/data/pgdata
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=scheduler
DB_USERNAME=scheduler
DB_PASSWORD=secret
FORWARD_DB_PORT=5432

# PostgreSQL 18 Test Database (§13)
DB_TEST_HOST=postgres
DB_TEST_PORT=5432
DB_TEST_DATABASE=scheduler_test
DB_TEST_USERNAME=scheduler
DB_TEST_PASSWORD=secret

# OIDC / Mock SSO Configuration (§10)
SSO_MOCK_ENABLED=true
SSO_ISSUER=http://localhost:3000
SSO_JWKS_URI=http://localhost:3000/oauth/jwks
SSO_AUDIENCE=scheduler-api
SSO_PRIVATE_KEY_PATH=storage/sso/private.pem
SSO_PUBLIC_KEY_PATH=storage/sso/public.pem
SSO_KEY_ID=scheduler-mock-rs256-key-1
SSO_TOKEN_TTL_SECONDS=900

# PostgreSQL Advisory Lock Namespaces & Timeouts (§8 & §7.5)
NS_BOOKING=1001
NS_CRON_EXPIRE=1002
BOOKING_LOCK_TIMEOUT_MS=2000
BOOKING_STATEMENT_TIMEOUT_MS=5000
BOOKING_LOCK_MAX_RETRIES=2
